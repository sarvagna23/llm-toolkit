class Completion:
    def __init__(self, text, input_tokens, output_tokens, latency_ms):
        self.text = text
        self.input_tokens = input_tokens
        self.output_tokens = output_tokens
        self.latency_ms = latency_ms

    def __repr__(self):
        return f"Completion(text={self.text!r}, input_tokens={self.input_tokens}, ...)"

    def __eq__(self, other):
        return (self.text, self.input_tokens, self.output_tokens, self.latency_ms) == (
            other.text, other.input_tokens, other.output_tokens, other.latency_ms
        )